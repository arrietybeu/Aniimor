# ---- Build outputs (regenerated by tool/build.py) ----
/build/
# (contains LuaScripts.xdf, LuaScripts.xdt, and the bc/ bytecode intermediate)

# ---- Proprietary game inputs — never commit shipped game assets ----
/tool/reference/
# original LuaScripts.orig.xdf/.xdt, md5list.orig.txt, LuaCacheVer.orig.txt

# ---- Binaries (build tools & game libs; kept on disk, not in VCS) ----
# xlua.dll is extracted from the client's Plugins/x86_64; recompiler.exe /
# decompiler .exe are locally built. See tool/README.md to reproduce.
*.exe
*.dll

# ---- Python ----
__pycache__/
*.pyc
*.pyo

# ---- intermediates / logs ----
*_recompile_manifest.txt
*.log
*.tmp

# ---- editor / OS ----
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
